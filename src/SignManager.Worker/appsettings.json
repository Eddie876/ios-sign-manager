{
  "Scheduler": {
    "AppConfigPath": "data/config/apps.json",
    "AppStatePath": "data/state/state.json",
    "WorkspaceRoot": "data/jobs",
    "ZsignExecutablePath": "zsign",
    "ScanIntervalSeconds": 30,
    "ZsignTimeoutSeconds": 1200,
    "MaxProcessOutputBytes": 262144,
    "CleanupMaxAgeHours": 72,
    "ProfileMinimumFreshHours": 144,
    "AppleDeviceUdid": "",
    "AppleDeviceName": "",
    "AppleTeamId": null,
    "AppleProfileNamePrefix": "signmanager",
    "ApplePrivateKeyPassword": "",
    "SigningStateRoot": "/signing-state",
    "AppleSessionSecretsPath": "/signing-state/secrets.enc",
    "AppleSessionMasterKeyPath": "/run/secrets/signmanager_master_key",
    "AppleAnisetteBaseUrl": "http://anisette:6969/",
    "AppleAnisetteHeadersPath": "headers",
    "AppleGrandSlamBaseUrl": "http://apple-gateway.local/",
    "AppleDeveloperBaseUrl": "http://apple-gateway.local/",
    "AppleHttpTimeoutSeconds": 30,
    "OtaPublicBaseUrl": "https://ios.example.com",
    "TelegramAlertsEnabled": false,
    "TelegramBotToken": null,
    "TelegramChatId": null
  },
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
